# ==============================================================================
# Environment Configuration
# ==============================================================================
NODE_ENV=development
PORT=4001
API_PREFIX=api
API_VERSION=1

# ==============================================================================
# Server & Swagger Documentation
# ==============================================================================
SERVER_URLS=http://localhost:4001, 
SWAGGER_ENABLED=true
SWAGGER_PATH=api/doc
SWAGGER_BASIC_AUTH_USERNAME=developer
SWAGGER_BASIC_AUTH_PASSWORD=changeme

# ==============================================================================
# MySQL Database Configuration (Sequelize)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=iam_db

DB_SYNC=false
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY=3000

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_REQUIRED=true
REDIS_KEY_PREFIX=bit-iam:
